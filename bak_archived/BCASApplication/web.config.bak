<handlers accessPolicy="Read, Execute, Script">
       
			
<add name=".att" path="*.att" verb="*" modules="IsapiModule" scriptProcessor="C:\Windows\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll" resourceType="File" preCondition="classicMode,runtimeVersionv2.0,bitness64" />
            <add name=".htm" path="*.htm" verb="*" modules="IsapiModule" scriptProcessor="C:\Windows\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll" resourceType="File" preCondition="classicMode,runtimeVersionv2.0,bitness64" />

			
</handlers>

<!-- Added on 20 May 2015 start-->
  <httpProtocol>
   <customHeaders>
   
	    <remove name="X-Powered-By: ARR/ 2.5" />
		<remove name="Server" />
        <clear /> 
		<add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Access-Control-Allow-Methods" value="GET, POST" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Content-Type" value="text/html; charset=utf-8" />  /*  use only those HTTP methods those are used by Application*/
			
  </customHeaders>
       	
        </httpProtocol>
<!-- Added on 20 May 2015 end-->




        <defaultDocument>
            <files>
                <add value="Home.aspx" />
            </files>
        </defaultDocument>
        <rewrite>
            <outboundRules>
                <rule name="Remove Server">
                    <match serverVariable="RESPONSE_SERVER" pattern=".+" />
                    <action type="Rewrite" />
                </rule>
                <rule name="Remove X-POWERED-BY">
                    <match serverVariable="RESPONSE_X-POWERED-BY" pattern=".*" />
                    <action type="Rewrite" />
                </rule>
                <rule name="Remove Aspnet Version">
                    <match serverVariable="RESPONSE_X-ASPNET-VERSION" pattern=".*" />
                    <action type="Rewrite" />
                </rule>
            </outboundRules>
        </rewrite>

    protected void btnSave_Click(object sender, EventArgs e)
    {
        if (Page.IsValid)
        {
            lblMsg.Visible = false;
            DeleteAllPrevBackups();

            TYP_DB_Backup objDBBKP = new TYP_DB_Backup();
            
            string path;
            string filename;

            filename = txtFileName.Text.Trim();
            path = Server.MapPath("~\\DataBase_Backup\\" + filename);

            objDBBKP.v_filePath = path;
            
            //objDBBKP.v_filePath = txtFileName.Text.Trim();
            bool  status;
            status = objDBBKP.Database_Backup();
            if (!status)
            {
                lblMsg.Visible = true;
                lblMsg.Text = "Database Backup Failed";
                //MessageBox("Database Backup Failed");
            }
            else
            {
               
                lblMsg.Visible = true;
                lblMsg.Text = "Database Backup Successful. Please Download it !!!";
                //MessageBox("Database Backup Successful");
            }

        }


    }

    

    public void MessageBox(string msg)
    {
        string MSG = String.Format("alert('" + msg + "')");
        ScriptManager.RegisterStartupScript(Page, Page.GetType(), "MSG", MSG, true);
    }

    protected void Button1_Click(object sender, EventArgs e)
    {
        //**********************
        // Get the physical Path of the file(test.doc)
        string filename;
        filename = txtFileName.Text.Trim();
        string filepath = Server.MapPath("~\\DataBase_Backup\\" + filename);

        //string filepath = Server.MapPath("http://192.168.1.218\\F:\\Software Development\\BCAS_Application\\BCAS\\BCAS\\BCASApplication\\DataBase_Backup\\" + filename);


        // Create New instance of FileInfo class to get the properties of the file being downloaded
        FileInfo file = new FileInfo(filepath);

        // Checking if file exists
        if (file.Exists)
        {
            // Clear the content of the response
            Response.ClearContent();

            // LINE1: Add the file name and attachment, which will force the open/cance/save dialog to show, to the header
            Response.AddHeader("Content-Disposition", "attachment; filename=" + file.Name);

            // Add the file size into the response header
            Response.AddHeader("Content-Length", file.Length.ToString());

            // Set the ContentType
            Response.ContentType = "application/bak";

            // Write the file into the response (TransmitFile is for ASP.NET 2.0. In ASP.NET 1.1 you have to use WriteFile instead)
            Response.TransmitFile(file.FullName);
                       
            // End the response
            Response.End();            
           
        }
        //if (file.Exists)
        //{
        //    File.Delete(Server.MapPath("~\\DataBase_Backup\\" + filename));
        //}
    }

    public void DeleteAllPrevBackups()
    {
        foreach (var f in System.IO.Directory.GetFiles(Server.MapPath("~/DataBase_Backup")))
            System.IO.File.Delete(f);
    }

    public void ClearCookiesSessions()
    {
        Session.Abandon();
        Session.Clear();
        Session.RemoveAll();

        string[] myCookies = Request.Cookies.AllKeys;
        foreach (string cookie in myCookies)
        {
            Response.Cookies[cookie].Expires = DateTime.Now.AddDays(-1);
        }
    }


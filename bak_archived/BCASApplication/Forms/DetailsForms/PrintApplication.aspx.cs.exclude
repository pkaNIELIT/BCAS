                    //                                     + "2. Candidate is advised to reach 30 minutes before commencement of examination (i.e 10:00 A.M on Date of Exam) and occupy his/her seat in the respective classroom for filling up necessary details on the OMR answer sheet. No candidate will be allowed to enter the Examination Centre after expiry of 30 minutes from the schedule time of commencement of examination."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "3. The Schedule of the examination will remain unaltered even if the date of examination is declared a public holiday."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "4. The candidates are advised to submit the question paper as well as answer sheet to the invigilator after the completion of the examination. No candidate would be allowed to leave without handing over of Answer Sheet & Question Paper."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "5. The paper will contain 100 objective type questions with four multiple choices."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "6. Possession and use of electronic devices such as Calculator, Digital Diary, Pager and Log Tables etc. is strictly prohibited. Issuing Authority."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "7. Please do not bring mobile phone at the Examination Centre. School authorites will not be held responsible for lost of the same."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "8. Your Candidature is provisional subject to your eligibility regarding age and academic Qualification."
                    //                                     + Chunk.NEWLINE + Chunk.NEWLINE
                    //                                     + "9. Mere appearance in the written test does not guarantee admission to the Course.", bodyFont));

                    //document.Add(InstructionsTable);
                    //document.Add(new Paragraph("*This is Computer Generated document, It doesn't require any signature or stamp.", SmallText));
                    //document.Add(Chunk.NEWLINE);

                    document.Close();

                    Response.ContentType = "application/pdf";
                    Response.AddHeader("Content-Disposition", string.Format("attachment;filename=Admit_Card-{0}.pdf", dt.Rows[0]["Candidate_Name"].ToString() + "_" + Convert.ToInt64(dt.Rows[0]["Registration_Number"].ToString()).ToString()));
                    Response.BinaryWrite(output.ToArray());

                }
                else
                {
                    lblError.Text = "No Record Found";
                    lblError.Visible = true;
                }

            }
            //###########            

        }
    }


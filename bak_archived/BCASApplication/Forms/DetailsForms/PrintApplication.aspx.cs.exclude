                    //cell.PaddingRight = 5;
                    //cell.HorizontalAlignment = 0; //0=Left, 1=Centre, 2=Right
                    //CandidateInfoTable.AddCell(cell);
                                                            
                    ////****
                    //CandidateInfoTable.HorizontalAlignment = 1;
                    //CandidateInfoTable.SpacingBefore = 10;
                    //CandidateInfoTable.SpacingAfter = 10;
                    //CandidateInfoTable.DefaultCell.BorderWidth = 1;
                    //CandidateInfoTable.SetWidths(new int[] { 5, 7, 8 });
                    //CandidateInfoTable.AddCell(new Phrase("Regd. No:", bodyFont));
                    //CandidateInfoTable.AddCell(Convert.ToInt64(dt.Rows[0]["Registration_Number"].ToString()).ToString());
                    //CandidateInfoTable.AddCell(new Phrase("Name:", bodyFont));
                    //CandidateInfoTable.AddCell(dt.Rows[0]["Candidate_Name"].ToString());
                    //CandidateInfoTable.AddCell(new Phrase("Sex:", bodyFont));
                    //CandidateInfoTable.AddCell(dt.Rows[0]["Sex_Code"].ToString());
                    //CandidateInfoTable.AddCell(new Phrase("Designation:", bodyFont));
                    //CandidateInfoTable.AddCell(dt.Rows[0]["Designation"].ToString());                    
                    //CandidateInfoTable.AddCell(new Phrase("Qualification:", bodyFont));
                    //CandidateInfoTable.AddCell(dt.Rows[0]["Qualification"].ToString());                   
                    //document.Add(CandidateInfoTable);

                    //###########
                    //////*********New Changed Code
                    var ExamDetailTable = new PdfPTable(2);
                    ExamDetailTable.TotalWidth = 500f;
                    ExamDetailTable.LockedWidth = true;
                    ExamDetailTable.DefaultCell.BorderWidth = 1;

                    cell = new PdfPCell(new Phrase("Candidate Details", boldTableFont));
                    cell.Colspan = 2;
                    cell.PaddingBottom = 5;
                    cell.HorizontalAlignment = 1; //0=Left, 1=Centre, 2=Right
                    ExamDetailTable.AddCell(cell);
                    //******
                 
                    ExamDetailTable.HorizontalAlignment = 1;
                    //CandidateInfoTable.SpacingBefore = 10;
                    //CandidateInfoTable.SpacingAfter = 10;
                    ExamDetailTable.DefaultCell.BorderWidth = 1;
                    ExamDetailTable.SetWidths(new int[] { 5, 15 });


                   

                    var imgPhoto = iTextSharp.text.Image.GetInstance(Server.MapPath("~//Upload//Photograph//" + dt.Rows[0]["Photo_Filename"].ToString()));
                    ExamDetailTable.AddCell(new Phrase("Candidate Photo:", bodyFont));
                    imgPhoto.ScaleAbsoluteHeight(60);
                    imgPhoto.ScaleAbsoluteWidth(70);

                    cell = new PdfPCell(imgPhoto);
                    ExamDetailTable.AddCell(cell);

                    var sign = iTextSharp.text.Image.GetInstance(Server.MapPath("~//Upload//Signature//" + dt.Rows[0]["Signature_Filename"].ToString()));
                    ExamDetailTable.AddCell(new Phrase("Sign:", bodyFont));
                    sign.ScaleAbsoluteHeight(60);
                    sign.ScaleAbsoluteWidth(70);
                    cell = new PdfPCell(sign);
                    ExamDetailTable.AddCell(cell);

                    ExamDetailTable.AddCell(new Phrase("Regd. No:", boldTableFont));
                    ExamDetailTable.AddCell(Convert.ToInt64(dt.Rows[0]["Registration_Number"].ToString()).ToString());

                    ExamDetailTable.AddCell(new Phrase("Name:", boldTableFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Candidate_Name"].ToString());

                    ExamDetailTable.AddCell(new Phrase("Sex:", bodyFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Sex_Code"].ToString());

                    ExamDetailTable.AddCell(new Phrase("Designation:", bodyFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Designation"].ToString());

                    ExamDetailTable.AddCell(new Phrase("Qualification:", bodyFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Qualification"].ToString());

                    ExamDetailTable.AddCell(new Phrase("Mobile No:", bodyFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Mobile_No"].ToString());

                    ExamDetailTable.AddCell(new Phrase("Country:", bodyFont));
                    ExamDetailTable.AddCell(dt.Rows[0]["Country_Name"].ToString());

                    
                    //ExamDetailTable.AddCell(iTextSharp.text.Image.GetInstance(Server.MapPath("~//Upload//Signature//" + dt.Rows[0]["Signature_Filename"].ToString())));

                    //ExamDetailTable.AddCell(new Phrase("Exam Date:" + dt.Rows[0]["Exam_Date"].ToString(), bodyFont));

                    //ExamDetailTable.AddCell(new Phrase("Exam Time:" + dt.Rows[0]["Exam_time"].ToString(), bodyFont));
                    //ExamDetailTable.AddCell(new Phrase("Reporting Time:" + "30 Minutes before Start Time", bodyFont));
                    //ExamDetailTable.AddCell(new Phrase("Exam Duration:" + "2 Hours", bodyFont));
                    document.Add(ExamDetailTable);
                    
                    //$$$$$$$$$$$
                    
                    //document.Add(Chunk.NEWLINE);
                    //document.Add(Chunk.NEWLINE);
                    //document.Add(new Phrase("", boldTableFont));
                    //document.Add(Chunk.NEWLINE);
                    //var InstructionsTable = new PdfPTable(1);
                    //InstructionsTable.TotalWidth = 500f;
                    //InstructionsTable.LockedWidth = true;
                    //InstructionsTable.AddCell(new Phrase(Chunk.NEWLINE + "Important Instructions to the Candidate" + Chunk.NEWLINE + Chunk.NEWLINE, bodyFont));
                    //InstructionsTable.AddCell(new Phrase("1. Please ensure to bring this admit card at the examination centre, failing which you will not be allowed to enter in the examination centre. Also please keep this Amit Card with you for future record."

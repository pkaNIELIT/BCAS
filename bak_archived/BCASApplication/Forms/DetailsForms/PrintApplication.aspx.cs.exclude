    protected void btnPrint_Click(object sender, EventArgs e)
    {
        if (Convert.ToInt32(txtRegNo.ToString().Length) != 0)
        {

            //**********
            objApplicant.i_Registration_Number = Convert.ToInt32(txtRegNo.Text);

            using (DataTable dt = objApplicant.getCandidateDetails_PrintApplication(Convert.ToInt32(txtRegNo.Text), Convert.ToInt32(Session["UserOrg"])))
            {
                if (dt.Rows.Count != 0)
                {
                   //*******For Printing of Application
                    // Create a Document object
                    var document = new Document(PageSize.A4, 50, 50, 25, 25);

                    // Create a new PdfWrite object, writing the output to a MemoryStream
                    var output = new MemoryStream();
                    var writer = PdfWriter.GetInstance(document, output);

                    // Open the Document for writing
                    document.Open();

                    // First, create our fonts... (For more on working w/fonts in iTextSharp, see: http://www.mikesdotnetting.com/Article/81/iTextSharp-Working-with-Fonts
                    var titleFont = FontFactory.GetFont("Arial", 18, Font.BOLD);
                    var subTitleFont = FontFactory.GetFont("Arial", 14, Font.BOLD);
                    var boldTableFont = FontFactory.GetFont("Arial", 14, Font.UNDERLINE);
                    var endingMessageFont = FontFactory.GetFont("Arial", 10, Font.ITALIC);
                    var bodyFont = FontFactory.GetFont("Arial", 12, Font.NORMAL);
                    var SmallText = FontFactory.GetFont("Arial", 8, Font.NORMAL);

                    // Create the Order Information table - see http://www.mikesdotnetting.com/Article/86/iTextSharp-Introducing-Tables for more info

                    var CandidateInfoTable = new PdfPTable(3);
                    CandidateInfoTable.TotalWidth = 500f;
                    CandidateInfoTable.LockedWidth = true;
                    CandidateInfoTable.DefaultCell.BorderWidth = 1;

                    var photo_Header = iTextSharp.text.Image.GetInstance(Server.MapPath("~/Images/bcas2.png"));
                    photo_Header.ScaleAbsoluteHeight(30);
                    photo_Header.ScaleAbsoluteWidth(500);

                    PdfPCell cell = new PdfPCell(photo_Header);
                    cell.Colspan = 3;
                    //cell. = 75;
                    cell.FixedHeight = 40;
                    CandidateInfoTable.AddCell(cell);
                    //cell = new PdfPCell(new Phrase("Candiadte Details", subTitleFont));

<%@ Page Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="ErrorPage.aspx.cs" Inherits="Forms_DetailForms_ErrorPage" Culture="en-GB" Title="ErrorPage" ValidateRequest="false"  %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    <table border="10" bordercolor="#CEEDEE" cellspacing="0" height="350" width="90%"
        style="border-collapse: collapse" cellpadding="0" align="center" >
        
        <tr>
            <td height="50px">
            </td>
        </tr>
 <tr>
        <td align="center" style="height: 12px"  >
            <asp:Label ID="lblMsg" runat="server" Font-Bold="True" Font-Size="Larger" 
                ForeColor="#CC0066" 
                Text="You are not authorized to use this Application. Please Login!!! "></asp:Label>
        </td>
 </tr>
 
 <tr>
        <td align="center" >
            <asp:LinkButton ID="LinkButton1" runat="server" Font-Bold="True" 
                Font-Size="Large" PostBackUrl="~/Home.aspx">Click Here To Login</asp:LinkButton>
        </td>
 </tr>
 
 </table> 

</asp:Content>


                                    <tr>
                                        <td width="100%">
                                            <table width="100%">
                                                <tr bgcolor="#99CCFF">
                                                    <td width="20%" align="left" >
                                                    <asp:Label ID="lblWelcome" runat="server" Visible="False"></asp:Label>
&nbsp;<asp:LoginView ID="ctlRightNavbar" runat="server">
                                     <AnonymousTemplate>
                                        <%-- <a class="navbar"></a>--%>
                                     </AnonymousTemplate>
                                     <LoggedInTemplate>
                                      <%--<a class="navbar">Welcome: 
                                             <asp:LoginName ID="ctlUserName" runat="server" />
                                         </a>--%>
                                    <asp:LoginName ID="ctlUserName" runat="server" />
                                     </LoggedInTemplate>
                                 </asp:LoginView>
                                                    </td>
                                                    <td width="65%" align="center" ><b>Online System of Registration for BCAS Training </b></td>
                                                    <td width="15%" align="right" >
                                                   <%-- <asp:LinkButton ID="lnkHome" runat="server" 
                                                CausesValidation="False" Visible="False" onclick="lnkHome_Click"></asp:LinkButton>--%>
                                                <asp:LoginStatus ID="LoginStatus" runat="server" 
                                LogoutPageUrl="~/Home.aspx"  onloggedout="LoginStatus_LoggedOut" 
                                Visible="False" />
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>                               
                                   <tr>
                                        <td valign="top" style="width: 20%; text-align: left;" align="right" 
                                            bgcolor="White"  >
                                        <asp:Menu ID="Menu1" runat="server" BorderColor="#333333" 
                    BorderStyle="None" DynamicHorizontalOffset="2" Font-Names="Arial Narrow" 
                    Font-Size="15px" ForeColor="#990000" Orientation="Horizontal" SkipLinkText="" 
                    RenderingMode="List" IncludeStyleBlock="false">
                                                 <StaticSelectedStyle ItemSpacing="5px" />
                                                 <StaticMenuItemStyle ItemSpacing="15px" />
                                                 <DynamicMenuStyle BorderColor="#6A0C23" CssClass="DynamicMenuZIndex" 
                                                     HorizontalPadding="10px" VerticalPadding="2px" />
                                                 <DynamicMenuItemStyle BorderColor="#6A0C23" BorderWidth="1px" 
                        HorizontalPadding="10px" ItemSpacing="2px" VerticalPadding="2px" BackColor ="White"  />
                                             </asp:Menu>
                                            </td>
                                    </tr>
                                    <tr align="center" >                                    
                                        <td valign="top" style="width: 20%" height="500px" >

                                          <asp:ScriptManager ID="ToolkitScriptManager1" runat="server">
                                            </asp:ScriptManager>
                                                                                                                                          
                                         <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                                             
                                         </asp:ContentPlaceHolder>                                         
                                            
                                        </td>
                                    </tr>
                                    </table>
                            </td>
                        </tr>                        

  <appSettings>
    <add key="BCAS" value="BCAS"/>
    <!--<add key="bcasurl" value="http://bcastest.nielit.in/Home.aspx" />-->
    <add key="ReportServerHost" value="172.25.5.7"/>
    <add key="ReportServerApps" value="ReportServer"/>
    <add key="ReportServerUser" value="administrator"/>
    <add key="ReportServerPass" value=""/>
    <add key="ReportServerDomain" value="DOEACCHQ"/>
    <add key="ReportPageUrl" value="/BCAS_Reports"/>
    <!--<add key="ReportServerHost" value="deep-pc" />
    <add key="ReportServerApps" value="ReportServer" />
    <add key="ReportServerUser" value="deep" />
    <add key="ReportServerPass" value="pp" />
    <add key="ReportServerDomain" value="DOEACCHQ" />
    <add key="ReportPageUrl" value="/BCAS_Reports" />-->
  </appSettings>
  <!-- Local Connection-->
  <!--<add name="BCASConnectionString" connectionString="Data Source=localhost;Initial Catalog=BCAS;User ID=sa;Password=abc123" providerName="System.Data.SqlClient"/>-->

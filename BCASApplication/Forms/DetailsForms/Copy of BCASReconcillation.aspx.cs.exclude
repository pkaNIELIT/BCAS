                    cmd.CommandText = "Select Transaction_id, ProformaInvoiceNo from Online_Transaction where Response_Status_Message='Success' and Is_Settled is  null and ProformaInvoiceID in (Select ID from Proforma_Invoice where Nominating_OrgCode=@OrgID and Schedule_ID=@ScheduleID)";

                    cmd.Parameters.AddWithValue("@OrgID", OrgID);
